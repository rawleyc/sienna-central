{"id":"43c38e48-b0a8-46e3-9118-2eee66e71ff3","rule_id":"b06ed843-f567-4937-acc5-a5cb7a67c30c","name":"Persistence - Registry Modifications","immutable":false,"rule_source":{"type":"internal"},"version":1,"revision":2,"updated_at":"2026-10-11T08:46:04.862Z","updated_by":"elastic","created_at":"2026-10-11T08:43:58.829Z","created_by":"elastic","enabled":true,"interval":"30s","from":"now-35s","to":"now","description":"This rule detects the modification of the registry via a base64 encoded parent process command","tags":[],"author":[],"license":"","threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0003","name":"Persistence","reference":"https://attack.mitre.org/tactics/TA0003/"},"technique":[{"id":"T1112","name":"Modify Registry","reference":"https://attack.mitre.org/techniques/T1112/","subtechnique":[]}]}],"related_integrations":[],"required_fields":[],"setup":"","false_positives":[],"references":[],"risk_score":73,"risk_score_mapping":[],"severity":"high","severity_mapping":[],"output_index":"","max_signals":100,"exceptions_list":[],"actions":[],"meta":{"kibana_siem_app_url":"https://sienna-central.valdron.dev/app/security"},"type":"query","language":"kuery","data_view_id":"logs-*","query":"process.name.text : \"reg.exe\" and (process.parent.command_line.text : \"*powershell.exe -enc\" OR process.parent.command_line.text : \"*powershell.exe -Enc *\") and process.command_line.text : \"*reg.exe add*\" and user.name : \"VICTIM\" ","filters":[]}
